Step 4: Kubernetes Deployment

deployment.yaml

apiVersion: apps/v1
kind: Deployment
metadata:
  name: employee-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: employee-app
  template:
    metadata:
      labels:
        app: employee-app
    spec:
      containers:
      - name: employee-app
        image: yourdockerhub/employee-app:v1
        ports:
        - containerPort: 8080


Apply:

Shell
kubectl apply -f deployment.yaml


apiVersion: v1
kind: Service
metadata:
  name: employee-app
spec:
  type: NodePort
  selector:
    app: employee-app
  ports:
  - port: 8080



Apply:

Shell
kubectl apply -f service.yaml
